# PRIVATE: two complete manifest URLs already installed as SH and SH2.
# Preserve their UUID/path tokens. Do NOT paste them in public messages.
# The sample assumes localhost-bound AIOMetadata on port 3232; adapt privately on the host.
SH_MANIFEST_URL=http://127.0.0.1:3232/REPLACE_SH_UUID/manifest.json
SH2_MANIFEST_URL=http://127.0.0.1:3232/REPLACE_SH2_UUID/manifest.json

# Optional, read-only Similar catalog: official TMDB collection siblings + SH recommendations.
# Leave disabled until staging tests pass and Bridge similar catalog is prioritized in AIOStreams.
COLLECTION_SIMILAR_ENABLED=0
# Set EITHER one private credential (TMDB v4 Read Access Token preferred), not both.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
